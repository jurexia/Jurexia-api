<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LA REGENERACIÓN SEMANAL DEL ÍNDICE DE VIGENCIA (26-sep-2026).

  Cada domingo a las 03:30, hora local, corre scripts/vigencia_semanal.sh: pone
  al día la caché del SJF (~/Documents/IUREXIA-MAC/reingesta/vigencia), rehace
  datos/vigencia_tesis.json y, si cambió y pasa la cordura y las pruebas, hace
  commit y push a main (Render despliega solo). Corre en la Mac porque el SJF
  bloquea con Incapsula las IP de Render y Vercel.

  StartCalendarInterval (y no StartInterval): si la Mac dormía a esa hora,
  launchd lo corre al despertar; si se perdieron varias, una sola vez.

  EL LANZADOR va aquí dentro (ProgramArguments) y no en un archivo del repo:
  antes el plist apuntaba al .sh del worktree dedicado, que no existe hasta la
  primera corrida, y al del checkout principal, que no lo tiene mientras no se
  actualice; launchd corría `zsh <inexistente>`, salía con 127 y nadie se
  enteraba (el aviso vivía dentro del .sh). Ahora el lanzador hace fetch, saca
  scripts/vigencia_semanal.sh de origin/main con `git show` y lo corre (el .sh
  crea el worktree dedicado si falta). Si no puede sacarlo, o si el .sh sale con
  código ≠ 0, lo escribe en el registro y avisa con una notificación. Se
  encarga él del registro (sin StandardOutPath: launchd no arranca el trabajo
  si falta la carpeta del archivo) y lo envuelve en `caffeinate -i` (la corrida
  dura ~50 min y la Mac no se duerme a medias).

  INSTALAR (o reinstalar tras un cambio de este plist), un solo comando en la
  terminal de la Mac, que es zsh (usa =(…) y ${P:h}). «preparar» va sin
  guiones dobles porque un comentario XML no los admite; el .sh lo acepta de
  las dos formas:

    R=$HOME/Documents/IUREXIA-MAC/jurexia-api-git; P=$HOME/Library/LaunchAgents/com.iurexia.vigencia-semanal.plist; git -C $R fetch -q origin && zsh =(git -C $R show origin/main:scripts/vigencia_semanal.sh) preparar && mkdir -p ${P:h} && git -C $R show origin/main:scripts/launchd/com.iurexia.vigencia-semanal.plist >| $P && plutil -lint -s $P && { launchctl bootout gui/$(id -u)/com.iurexia.vigencia-semanal 2>/dev/null; launchctl bootstrap gui/$(id -u) $P } && echo "✓ instalado: domingos 03:30"

    («preparar» es el bootstrap: crea el worktree dedicado con su marca, le
    enlaza el .env y comprueba el Python, sin tocar el SJF ni el índice; si
    algo falta, se sabe ahora y no el domingo de madrugada.)

  PROBAR YA (corrida completa, con commit y push):
    launchctl kickstart -p gui/$(id -u)/com.iurexia.vigencia-semanal

  QUITAR, un solo comando:

    launchctl bootout gui/$(id -u)/com.iurexia.vigencia-semanal; rm -f $HOME/Library/LaunchAgents/com.iurexia.vigencia-semanal.plist && echo "✓ quitado"

    (Quedan el worktree dedicado y la caché del SJF. Para borrar también el
    worktree: git -C $HOME/Documents/IUREXIA-MAC/jurexia-api-git worktree remove -f $HOME/Documents/IUREXIA-MAC/wt-vigencia-semanal)

  REGISTRO:    ~/Library/Logs/iurexia/vigencia-semanal.log (línea «RESUMEN · …»;
               los fallos del lanzador, «✗ lanzador: …»)
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.iurexia.vigencia-semanal</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string><![CDATA[
# El lanzador. Las VIGENCIA_* sólo las cambian las pruebas; launchd no las pone.
R=${VIGENCIA_REPO:-${VIGENCIA_MAC:-/Users/josedavidalcantarmendoza/Documents/IUREXIA-MAC}/jurexia-api-git}
L=${VIGENCIA_LOG:-$HOME/Library/Logs/iurexia/vigencia-semanal.log}
if mkdir -p ${L:h} 2>/dev/null && [[ -w ${L:h} ]]; then exec >>$L 2>&1; fi
avisa() {
  print -r -- "[$(date '+%Y-%m-%d %H:%M:%S')] ✗ lanzador: $1 (aviso)"
  [[ -n ${VIGENCIA_SIN_AVISO:-} ]] || /usr/bin/osascript -e "display notification \"$1\" with title \"Iurexia · vigencia semanal\"" >/dev/null 2>&1
}
f=$(mktemp -t vigencia-semanal) || { avisa "no pude crear un archivo temporal"; exit 1 }
git -C $R fetch -q origin || print -r -- "[$(date '+%Y-%m-%d %H:%M:%S')]   lanzador: git fetch falló; uso el origin/main que ya había"
if ! git -C $R show origin/main:scripts/vigencia_semanal.sh >| $f || [[ ! -s $f ]]; then
  rm -f $f
  avisa "no pude sacar scripts/vigencia_semanal.sh de origin/main en $R"
  exit 1
fi
c=(); [[ -x /usr/bin/caffeinate ]] && c=(/usr/bin/caffeinate -i)
VIGENCIA_SIN_AVISO=1 $c /bin/zsh $f "$@"
rc=$?
rm -f $f
(( rc == 0 )) || avisa "salió con código $rc; revisa $L"
exit $rc
]]></string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/josedavidalcantarmendoza/Documents/IUREXIA-MAC/jurexia-api-git/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>LANG</key>
		<string>es_MX.UTF-8</string>
		<key>PYTHONIOENCODING</key>
		<string>utf-8</string>
	</dict>

	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
